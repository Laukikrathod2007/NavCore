# NavCore Environment Configuration
# Copy this file to .env and adjust values as needed.

# Local LLM; Railway does not provide Ollama, so template directions are used.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Embeddings and voice model
EMBEDDING_MODEL=intfloat/multilingual-e5-small
WHISPER_MODEL=tiny

# API
API_HOST=0.0.0.0
API_PORT=8001
NAVCORE_ENV=production
